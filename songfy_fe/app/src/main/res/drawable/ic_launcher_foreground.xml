<?xml version="1.0" encoding="utf-8"?>
<!--
    Songfy App Icon Foreground
    Silver metallic double-beamed music note on transparent background.
    Viewport: 108x108dp (Android adaptive icon safe zone: 72x72dp center).
    The note sits centered in the safe zone with metallic silver gradient.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Double beamed eighth note (♫):
        - Beam: horizontal rectangle across the top connecting both stems
        - Left stem: vertical line down from beam left
        - Right stem: vertical line down from beam right
        - Left note head: tilted oval at bottom-left of left stem
        - Right note head: tilted oval at bottom-right of right stem
        Positioned centered in safe zone (~18dp margin each side).
    -->

    <!-- Left note head -->
    <path
        android:pathData="M33,74 C33,69.6 36.8,66 41.5,66 C46.2,66 50,69.6 50,74 C50,78.4 46.2,82 41.5,82 C36.8,82 33,78.4 33,74 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="33"
                android:startY="66"
                android:endX="50"
                android:endY="82">
                <item android:offset="0.0" android:color="#D0D0D0" />
                <item android:offset="0.5" android:color="#A0A0A0" />
                <item android:offset="1.0" android:color="#686868" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Right note head -->
    <path
        android:pathData="M58,70 C58,65.6 61.8,62 66.5,62 C71.2,62 75,65.6 75,70 C75,74.4 71.2,78 66.5,78 C61.8,78 58,74.4 58,70 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="58"
                android:startY="62"
                android:endX="75"
                android:endY="78">
                <item android:offset="0.0" android:color="#C8C8C8" />
                <item android:offset="0.5" android:color="#989898" />
                <item android:offset="1.0" android:color="#606060" />
            </gradient>
        </aapt:attr>
    </path>

    <!--
        The beamed connector:
        Left stem top: x=43, y=74 going up to y=30
        Right stem top: x=67, y=70 going up to y=30
        Beam: rectangle from x=43,y=30 to x=75,y=40 (slight slope for reference style)
        Combined as a single path for correct metallic gradient rendering.
    -->
    <path
        android:pathData="
            M43,74 L43,32
            L67,28 L67,70
            L62,70 L62,32
            L48,35 L48,74 Z
            M43,32 L67,28 L75,30 L75,40 L43,42 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="43"
                android:startY="28"
                android:endX="75"
                android:endY="74">
                <item android:offset="0.0" android:color="#E8E8E8" />
                <item android:offset="0.3" android:color="#C0C0C0" />
                <item android:offset="0.7" android:color="#909090" />
                <item android:offset="1.0" android:color="#606060" />
            </gradient>
        </aapt:attr>
    </path>

</vector>